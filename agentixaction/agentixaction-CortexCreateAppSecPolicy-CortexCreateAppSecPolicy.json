  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: scope_business_application_names
  required: false
  type: string
  underlyingargname: scope_business_application_names
- description: |
    Filter applications by business criticality. Options: CRITICAL, HIGH, MEDIUM, LOW.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: scope_application_business_criticality
  required: false
  type: string
  underlyingargname: scope_application_business_criticality
