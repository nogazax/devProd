args:
- description: |
    A unique name for the AppSec policy following the organization's naming conventions.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: policy_name
  required: true
  type: string
  underlyingargname: policy_name
- description: |
    A descriptive summary of the policy's objective and expected outcomes.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: description
  required: false
  type: string
  underlyingargname: description
- description: |
    A comma-separated list of Asset Group names to apply the policy to.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: asset_group_names
  required: false
  type: string
  underlyingargname: asset_group_names
- description: |
    A comma-separated list of specific finding types to target policy enforcement. Options: Vulnerabilities, IaC Misconfiguration, Licenses, Operational Risk, Secrets, Code Weaknesses, CI/CD Risks, Drift, Malware. Also accepts raw API values: VULNERABILITY, IAC_MISCONFIGURATION, LICENSES, OPERATIONAL_RISK, SECRETS, CODE_WEAKNESS, CICD_RISKS, DRIFT, MALWARE.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: conditions_finding_type
  required: false
  type: string
  underlyingargname: conditions_finding_type
- description: |
    Filters findings by their assigned risk impact level to (e.g., Critical, High, Medium, or Low). Options: CRITICAL, HIGH, MEDIUM, LOW.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: conditions_severity
  required: false
  type: string
  underlyingargname: conditions_severity
- description: |
    Determines whether the policy should honor developer-suppressed findings. Set to 'true' to EXCLUDE vulnerabilities that were suppressed by a developer. Set to 'false' to IGNORE developer suppression and evaluate all findings, even if a developer has suppressed them.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: conditions_respect_developer_suppression
  required: false
  type: boolean
  underlyingargname: conditions_respect_developer_suppression
- description: |
    Filter findings based on their backlog workflow status. Options: NEW, BACKLOG.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: conditions_backlog_status
  required: false
  type: string
  underlyingargname: conditions_backlog_status
- description: |
    Filter findings by specific software package names.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: conditions_package_name
  required: false
  type: string
  underlyingargname: conditions_package_name
- description: |
    Filter findings by software package version.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: conditions_package_version
  required: false
  type: string
  underlyingargname: conditions_package_version
- description: |
    Filter packages by their operational risk assessment level. Options: LOW, MEDIUM, HIGH
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: conditions_package_operational_risk
  required: false
  type: string
  underlyingargname: conditions_package_operational_risk
- description: |
