  isdetailsoverridden: false
  isgeneratable: false
  name: enable_git_history
  required: false
  type: boolean
  underlyingargname: enable_git_history
- description: Enable scanning on pull requests.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
